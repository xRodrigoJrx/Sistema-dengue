table vw_historico_dengue
	lineageTag: 11dcc950-1511-4539-b9d3-52a240586c66

	measure 'Casos Reportados' =
			
			CALCULATE(
			    SUM('vw_historico_dengue'[casos_reportados]),
			    'vw_historico_dengue'[registro_minsa] = TRUE()
			)
		formatString: 0
		lineageTag: 0fc984eb-5ad6-4eee-92c6-2b431380d170

	measure 'Registros MINSA' =
			
			CALCULATE(
			    COUNTROWS('vw_historico_dengue'),
			    'vw_historico_dengue'[registro_minsa] = TRUE()
			)
		formatString: 0
		lineageTag: b1d0399b-5723-44d4-b8cb-03ff92c581d9

	measure 'Distritos con Registro' =
			
			CALCULATE(
			    DISTINCTCOUNT('vw_historico_dengue'[ubigeo]),
			    'vw_historico_dengue'[registro_minsa] = TRUE()
			)
		formatString: 0
		lineageTag: 5bfbbedb-cb62-4395-8414-879fceb30f02

	measure 'Promedio de Casos' =
			
			DIVIDE(
			    [Casos Reportados],
			    [Registros MINSA],
			    0
			)
		lineageTag: 9142ba8c-ccbf-4986-829c-98d39d2eb5e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Temperatura Media' =
			
			AVERAGE('vw_historico_dengue'[tmean])
		lineageTag: 4a56ac53-65a7-4281-bf99-1425cb10ba9f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Precipitacion Media' =
			
			AVERAGE('vw_historico_dengue'[ptot])
		lineageTag: 6354b38e-f37d-4054-a328-3585317463d7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fecha Corte Historico' =
			
			CALCULATE(
			    MAX('vw_historico_dengue'[fecha_inicio]),
			    REMOVEFILTERS('DimFecha')
			)
		formatString: General Date
		lineageTag: de8ec852-b898-450a-a8ac-742b7fedeb4b

	measure 'Casos Año Anterior' =
			
			CALCULATE(
			    [Casos Reportados],
			    SAMEPERIODLASTYEAR('DimFecha'[Date])
			)
		formatString: 0
		lineageTag: 9b634da1-06cf-4bb3-85c8-7801f492a9a7

	measure 'Variacion Interanual %' =
			
			DIVIDE(
			    [Casos Reportados] - [Casos Año Anterior],
			    [Casos Año Anterior]
			)
		lineageTag: dd0c0698-4602-467f-9870-abf2485afd7c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

