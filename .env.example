# SQL Server Express local: instancia detectada en este equipo
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=dengue_analytics
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_AUTH=windows
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes

# Groq: agrega tu API key. No la compartas ni la subas a GitHub.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Origenes permitidos para la aplicación web (ajustar al puerto real)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
